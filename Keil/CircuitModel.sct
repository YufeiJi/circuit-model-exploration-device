; *****************************************************************************
; CircuitModel.sct  --  linker scatter file
;
; STM32F407VET6:
;   Flash  0x08000000  512 KB
;   SRAM   0x20000000  128 KB
;
; Used because "Use Memory Layout from Target Dialog" is unchecked in
; Options for Target -> Linker.  Path: .\CircuitModel.sct
; *****************************************************************************

LR_IROM1 0x08000000 0x00080000  {    ; load region: 512 KB Flash
  ER_IROM1 0x08000000 0x00080000  {  ; execute region = load region
   *.o (RESET, +First)               ; vector table first
   *(InRoot$$Sections)               ; __main and C library init
   .ANY (+RO)                        ; all other code and constants
   .ANY (+XO)
  }
  RW_IRAM1 0x20000000 0x00020000  {  ; 128 KB SRAM
   .ANY (+RW +ZI)                    ; initialised + zero-init data, stack, heap
  }
}
